# Copy to .env locally; Node loads this only with --env-file=.env.
PGHOST=your-server.postgres.database.azure.com
PGDATABASE=shopstream
PGUSER=shopstream_developer
ENTRA_CREDENTIAL=azure-cli
AZURE_TENANT_ID=your-tenant-id
AZURE_SUBSCRIPTION_ID=your-subscription-id
# In Builder use managed-identity instead; leave AZURE_CLIENT_ID unset for system-assigned.
# SHOPSTREAM_ENABLE_DEMO_WRITES=true enables unauthenticated, bounded DEV/TEST writes.
# For enabled hosted writes, set the exact public HTTPS origin (no trailing slash).
# SHOPSTREAM_PUBLIC_ORIGIN=https://your-app.app.region.builderapps.dev
# Leave unset for direct local development; forwarded headers are never trusted.
